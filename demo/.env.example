# This file configures only the local/demo persistence target. Never copy a
# customer DATABASE_URL here.
DEMO_MODE=true
RESEARCHOS_DATABASE_URL_DEMO=sqlite:///demo/work/research_library.db
RESEARCHOS_DEMO_WORK_DIRECTORY=demo/work
RESEARCHOS_DEMO_CORPUS_TARGET=ResearchOS Demo Workspace

# Configure these only in your local environment or deployment secret store.
DEMO_OWNER_EMAIL=demo.owner@example.invalid
DEMO_OWNER_NAME=Demo Owner
DEMO_OWNER_PASSWORD=
DEMO_REVIEWER_EMAIL=demo.reviewer@example.invalid
DEMO_REVIEWER_NAME=Demo Reviewer
DEMO_REVIEWER_PASSWORD=

# Required by the existing public-PDF ingestion and embedding path.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
