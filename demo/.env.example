# This file configures only the local/demo persistence target. Never copy a
# customer DATABASE_URL here.
DEMO_MODE=true
# These are the values used by the FastAPI process itself. They must point to
# the same isolated target as the demo utility aliases below.
DATABASE_URL=sqlite:///demo/work/research_library.db
WORK_DIRECTORY=demo/work
STORAGE_ROOT=demo/work/runtime_storage
RESEARCHOS_DATABASE_URL_DEMO=sqlite:///demo/work/research_library.db
RESEARCHOS_DEMO_WORK_DIRECTORY=demo/work
RESEARCHOS_DEMO_CORPUS_TARGET=ResearchOS Demo Workspace

# Release identity is public, non-secret metadata. The guarded local launcher
# derives RESEARCHOS_COMMIT from `git rev-parse HEAD` when this value is empty.
RESEARCHOS_RELEASE=researchos-demo-v200
RESEARCHOS_COMMIT=
RESEARCHOS_FRONTEND_VERSION=v200
RESEARCHOS_ENVIRONMENT=demo
RESEARCHOS_RELEASE_GUARD=true
# Required only when the isolated Demo frontend is served from localhost.
RESEARCHOS_ALLOW_LOCAL_CORS=true

# Configure these only in your local environment or deployment secret store.
DEMO_OWNER_EMAIL=demo.owner@example.invalid
DEMO_OWNER_NAME=Demo Owner
DEMO_OWNER_PASSWORD=
DEMO_REVIEWER_EMAIL=demo.reviewer@example.invalid
DEMO_REVIEWER_NAME=Demo Reviewer
DEMO_REVIEWER_PASSWORD=

# Required by the existing public-PDF ingestion and embedding path.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
