# Copy to .env only for local development. Never commit actual values.
# SQLite uses an absolute path in production; the local default is safe when omitted.
DATABASE_URL=
WORK_DIRECTORY=
STORAGE_PROVIDER=LOCAL
STORAGE_ROOT=

# Opaque sessions are server-side and hashed. TOKEN_EXPIRE is seconds (15m–7d).
TOKEN_EXPIRE=43200
# Reserved for an approved deployment gateway; ResearchOS does not use JWTs.
SECRET_KEY=

# Explicitly enable only in an isolated public demo environment.
DEMO_MODE=false
DEMO_OWNER_EMAIL=
DEMO_OWNER_NAME=
DEMO_OWNER_PASSWORD=
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_NAME=
DEMO_REVIEWER_PASSWORD=

# Public release identity. For a Demo deployment, the guarded local launcher
# derives RESEARCHOS_COMMIT from `git rev-parse HEAD` when this value is empty.
# Render deployments use the built-in RENDER_GIT_COMMIT at runtime.
RESEARCHOS_RELEASE=researchos-demo-v200
RESEARCHOS_COMMIT=
RESEARCHOS_FRONTEND_VERSION=v200
RESEARCHOS_ENVIRONMENT=demo
RESEARCHOS_RELEASE_GUARD=false

# Set the public Vercel origin after it is created; comma-separate multiple origins.
CORS_ALLOWED_ORIGINS=
# Local browser origins are opt-in. Keep this false in a managed public Demo.
RESEARCHOS_ALLOW_LOCAL_CORS=true

# Static-site build variable (configure in Render Static Site or Vercel, not
# in the FastAPI runtime). Supply the API host for your own deployment.
RESEARCHOS_API_URL=https://<your-api-host>

# Model configuration. DASHSCOPE_API_KEY is the currently implemented provider key.
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
LLM_RUNTIME_ENABLED=false
MODEL_PROVIDER=DASHSCOPE
MODEL_NAME=qwen-plus

# Reserved aliases for a future provider adapter. They are not read by the
# current runtime and must remain empty unless that adapter is implemented.
LLM_API_KEY=
EMBEDDING_API_KEY=

# Runtime limits are non-secret configuration.
RUNTIME_MAX_RETRIES=3
WORKER_POLL_SECONDS=2
REQUIRE_HUMAN_REVIEW=true
