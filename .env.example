# Copy this file to .env, then add your DashScope API key. Do not commit .env.
DASHSCOPE_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# P34 deployment runtime (all values are safe placeholders/defaults).
DATABASE_URL=sqlite:///work/research_library.db
STORAGE_PROVIDER=LOCAL
STORAGE_ROOT=work/runtime_storage
RUNTIME_MAX_RETRIES=3
WORKER_POLL_SECONDS=5
REQUIRE_HUMAN_REVIEW=true

